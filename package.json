{
  "name": "pixelkit-docs",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Documentation site for PixelKit. Renders the markdown that lives in the SDK repository.",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "npm run sync && astro dev",
    "start": "npm run sync && astro dev",
    "build": "npm run check:diagrams && npm run check:api && npm run sync && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "build:diagrams": "node scripts/build-diagrams.mjs",
    "check:diagrams": "node scripts/check-diagrams.mjs",
    "check:api": "node scripts/check-api-reference.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.2.10",
    "sharp": "^0.35.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PixelKit-Labs/pixelkit-docs.git"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "^0.4.0"
  }
}
