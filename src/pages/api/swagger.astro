---
import { withBase } from '../../../site.config.mjs';

const openApiUrl = withBase('/openapi.json');
const backUrl = withBase('/api/openapi/');
const explorerUrl = withBase('/api/explorer/');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>PixelKit API - Swagger UI</title>
  <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
  <link rel="stylesheet" href="https://unpkg.com/swagger-ui-dist@5/swagger-ui.css" />
  <style>
    body {
      margin: 0;
      padding: 0;
      background: #fafafa;
    }
    .top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 20px;
      background: #111827;
      border-bottom: 1px solid #1f2937;
      font-size: 14px;
      color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .top-bar a {
      color: #38bdf8;
      text-decoration: none;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .top-bar a:hover {
      text-decoration: underline;
    }
    .top-bar .links {
      display: flex;
      gap: 16px;
      align-items: center;
    }
  </style>
</head>
<body>
  <div class="top-bar">
    <div>
      <a href={backUrl}>← Back to Documentation</a>
      <span style="margin: 0 8px; color: #475569;">|</span>
      <strong>PixelKit Swagger UI</strong>
    </div>
    <div class="links">
      <a href={explorerUrl}>Switch to Scalar Explorer</a>
      <a href={openApiUrl} download="openapi.json">Download JSON</a>
      <a href={withBase('/openapi.yaml')} download="openapi.yaml">Download YAML</a>
    </div>
  </div>

  <div id="swagger-ui"></div>

  <script src="https://unpkg.com/swagger-ui-dist@5/swagger-ui-bundle.js"></script>
  <script src="https://unpkg.com/swagger-ui-dist@5/swagger-ui-standalone-preset.js"></script>
  <script define:vars={{ openApiUrl }}>
    window.onload = () => {
      window.ui = SwaggerUIBundle({
        url: openApiUrl,
        dom_id: '#swagger-ui',
        deepLinking: true,
        presets: [
          SwaggerUIBundle.presets.apis,
          SwaggerUIStandalonePreset
        ],
        layout: "BaseLayout"
      });
    };
  </script>
</body>
</html>
