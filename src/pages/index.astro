---
/**
 * @file index.astro
 * @description The documentation landing page.
 *
 * Deliberately outside the sync pipeline: scripts/sync-docs.mjs writes src/content/docs/ and never
 * touches src/pages/, so this hand-written page cannot be clobbered by a docs rebuild.
 *
 * It answers the four questions a reader actually arrives with, in order: what can I read off the
 * phone, how do I install it, what does the code look like, and what will stop me. The provenance
 * design lives on its own page - it is what makes the readings trustworthy once you are using them,
 * not what decides whether to install.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { CardGrid, LinkCard, Aside, Code } from '@astrojs/starlight/components';

const installExample = `npx expo install @pixelkit-labs/sdk @pixelkit-labs/native

# on-device ML, opt-in: adds 19 ML Kit artifacts to your APK
npx expo install @pixelkit-labs/mlkit`;

const usageExample = `import { useCPU, useSensors, useBiometrics } from '@pixelkit-labs/sdk';
import { useGeminiNano } from '@pixelkit-labs/sdk/mlkit';

function Readout() {
  const cpu = useCPU();
  const { pressure } = useSensors();

  return (
    <>
      <Text>{cpu.cores[0]?.curMHz ?? '—'} MHz</Text>
      <Text>{pressure ?? '—'} hPa</Text>
    </>
  );
}`;
---

<StarlightPage
	frontmatter={{
		title: 'PixelKit',
		description:
			'An on-device AI development kit for the Google Pixel. Gemini Nano, ML Kit vision, offline translation and speech as typed React hooks for Expo and React Native.',
		template: 'splash',
		hero: {
			title: 'On-device AI, as React hooks.',
			tagline:
				'Gemini Nano running on the phone itself, with no network at all. Document scanning, barcode, face and text recognition. Translation across 58 languages offline. Speech in both directions. Summarize, proofread and rewrite on the Tensor chip. And because on-device inference is thermally expensive and capability-gated, the same kit tells you what AICore actually exposes, which Nano tier this device serves, and how much thermal headroom is left before you should fall back to cloud.',
			actions: [
				{ text: 'Get started', link: '/getting-started/quickstart/', variant: 'primary', icon: 'right-arrow' },
				{ text: 'API reference', link: '/api/hardware-api/', variant: 'secondary' },
			],
		},
	}}
>
	<div class="sl-markdown-content">
		<h2>Install</h2>
		<Code code={installExample} lang="sh" />

		<Aside type="caution" title="Android, and a development build">
			The hooks talk to Kotlin native modules that have to be compiled into your app, so this
			cannot run in Expo Go. Build it onto the device with <code>npx expo run:android</code> — one
			command, a few minutes the first time. On other platforms every native-backed hook reports
			<code>unavailable</code>.
		</Aside>

		<h2>Use it</h2>
		<Code code={usageExample} lang="tsx" />

		<h2>What you can read</h2>
		<table>
			<thead>
				<tr><th>Area</th><th>Hooks</th></tr>
			</thead>
			<tbody>
				<tr>
					<td><strong>Silicon</strong></td>
					<td><code>useCPU</code> <code>useGPU</code> <code>useMemory</code> <code>useADPF</code> <code>useTPU</code></td>
				</tr>
				<tr>
					<td><strong>System</strong></td>
					<td><code>useDevice</code> <code>useDisplay</code> <code>useNetwork</code> <code>useCellular</code> <code>useCapabilities</code></td>
				</tr>
				<tr>
					<td><strong>Sensors</strong></td>
					<td><code>useSensors</code> <code>useLocation</code> <code>useCamera</code> <code>useVideo</code> <code>useMediaLibrary</code> <code>useAudio</code></td>
				</tr>
				<tr>
					<td><strong>Actuators</strong></td>
					<td><code>useHaptics</code> <code>useTorch</code> <code>useHiLight</code></td>
				</tr>
				<tr>
					<td><strong>Radios</strong></td>
					<td><code>useBLE</code> <code>useNFC</code> <code>useUWB</code> <code>useRadios</code></td>
				</tr>
				<tr>
					<td><strong>Security</strong></td>
					<td><code>useBiometrics</code> <code>useSecurity</code></td>
				</tr>
				<tr>
					<td><strong>AI</strong></td>
					<td><code>useGemini</code> <code>useSpeechAI</code> <code>useSpeech</code> <code>useGeminiNano</code> <code>useGenAITasks</code> <code>useVisionAI</code> <code>useNaturalLanguageAI</code></td>
				</tr>
			</tbody>
		</table>

		<p>
			Every hook is documented with its arguments, every field it returns with the type it really
			has, and a contract for each function it exposes.
		</p>

		<h2>Where to go</h2>
		<CardGrid>
			<LinkCard
				title="Quickstart"
				href="/getting-started/quickstart/"
				description="Install, build onto a device, and read your first value."
			/>
			<LinkCard
				title="API reference"
				href="/api/hardware-api/"
				description="Every hook: inputs, outputs, and what failure looks like."
			/>
			<LinkCard
				title="Guides"
				href="/guides/"
				description="On-device Gemini Nano, function calling, and voice."
			/>
			<LinkCard
				title="Architecture"
				href="/getting-started/architecture/"
				description="How the hooks reach the hardware, layer by layer."
			/>
		</CardGrid>

		<p>
			Built from <a href="https://github.com/PixelKit-Labs/pixelkit-template">the template</a>? It
			is a working four-tab app exercising every hook on a real device. Something reading
			<code>—</code> and you are not sure why? <code>npx @pixelkit-labs/cli doctor</code> says which of
			adb, the device, the development build or AICore is missing.
		</p>
	</div>
</StarlightPage>
