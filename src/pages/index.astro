---
/**
 * @file index.astro
 * @description The documentation landing page.
 *
 * Deliberately outside the sync pipeline: scripts/sync-docs.mjs writes src/content/docs/ and never
 * touches src/pages/, so this hand-written page cannot be clobbered by a docs rebuild.
 *
 * It answers the four questions a reader actually arrives with, in order: what can I read off the
 * phone, how do I install it, what does the code look like, and what will stop me. The provenance
 * design lives on its own page - it is what makes the readings trustworthy once you are using them,
 * not what decides whether to install.
 */
import { readdirSync, readFileSync } from 'node:fs';
import path from 'node:path';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { CardGrid, LinkCard, Aside, Code } from '@astrojs/starlight/components';
import pixelHero from '../assets/pixel-hero.png';
import { getImage } from 'astro:assets';
import { withBase } from '../../site.config.mjs';

/**
 * The hook table, read from `data/hooks` at build time.
 *
 * It used to be written out by hand, and it was the last place still claiming 32 hooks: it never
 * caught up to 39, and was 19 behind by the time the next-gen hooks landed. The landing page is
 * where most readers form their idea of how much the SDK covers, so it is the worst page to let
 * drift. Deriving it means a new hook appears here the moment its definition exists.
 */
const SECTION_OF = {
  silicon: 'silicon-compute', compute: 'silicon-compute', ai: 'neural-ai',
  sensors: 'sensors-actuators', radios: 'radios-security', security: 'radios-security',
  system: 'system-media', pro: 'pro-exclusives',
};
const AREA_LABEL = {
  'silicon-compute': 'Silicon & compute',
  'system-media': 'System & media',
  'sensors-actuators': 'Sensors & actuators',
  'radios-security': 'Radios & security',
  'neural-ai': 'AI',
  'pro-exclusives': 'Pixel Pro',
};

const hooksDir = path.resolve(process.cwd(), 'data', 'hooks');
const allHooks = readdirSync(hooksDir)
  .filter((f) => f.endsWith('.json'))
  .map((f) => JSON.parse(readFileSync(path.join(hooksDir, f), 'utf8')))
  .sort((a, b) => a.name.localeCompare(b.name));

const hookAreas = Object.entries(AREA_LABEL).map(([section, label]) => ({
  label,
  hooks: allHooks.filter((h) => SECTION_OF[h.category] === section),
}));
const hookCount = allHooks.length;

/**
 * Starlight renders hero.image.file through <Image width={400} height={400}>, which squashes a
 * portrait source into a square and caps it at 400px. The markup is supplied directly instead, but
 * through getImage() rather than a bare <img> so Astro still optimises, converts to WebP and emits
 * a srcset - the audit flags a raw <img> here, and it is right to.
 */
const heroImage = await getImage({
	src: pixelHero,
	widths: [425, 640, 850],
	sizes: '(min-width: 72rem) 46rem, (min-width: 50rem) 30rem, 80vw',
	format: 'webp',
});

const installExample = `npx expo install @pixelkit-labs/sdk @pixelkit-labs/native

# on-device ML, opt-in: adds 19 ML Kit artifacts to your APK
npx expo install @pixelkit-labs/mlkit`;

const usageExample = `import { useCPU, useSensors, useBiometrics } from '@pixelkit-labs/sdk';
import { useGeminiNano } from '@pixelkit-labs/sdk/mlkit';

function Readout() {
  const cpu = useCPU();
  const { pressure } = useSensors();

  return (
    <>
      <Text>{cpu.cores[0]?.curMHz ?? '—'} MHz</Text>
      <Text>{pressure ?? '—'} hPa</Text>
    </>
  );
}`;
---

<StarlightPage
	frontmatter={{
		title: 'PixelKit',
		description:
			'PixelKit is an SDK for building Expo and React Native applications on Google Pixel devices. Typed React hooks for device sensors, radios, secure hardware, camera and audio, display and power telemetry, haptics, on-device AI, and Cloud AI.',
		template: 'splash',
		hero: {
			title: 'PixelKit',
			tagline:
				'An SDK for building Expo and React Native applications on Google Pixel devices. Typed React hooks for device sensors, radios, secure hardware, camera and audio, display and power telemetry, haptics, on-device AI, and Cloud AI.',
			image: {
				// Starlight's Hero renders `file` through <Image width={400} height={400}>, which squashes a
				// portrait source into a square and caps it at 400px. Supplying the markup directly keeps the
				// real aspect ratio and lets src/styles/pixelkit.css size it.
				html: `<img src="${heroImage.src}" srcset="${heroImage.srcSet.attribute}" sizes="${heroImage.attributes.sizes}" width="${heroImage.attributes.width}" height="${heroImage.attributes.height}" alt="A Google Pixel showing the PixelKit shield on screen" loading="eager" decoding="async" class="pixel-hero" />`,
			},
			actions: [
				{ text: 'Get started', link: withBase('/getting-started/quickstart/'), variant: 'primary', icon: 'right-arrow' },
				{ text: 'API reference', link: withBase('/api/'), variant: 'secondary' },
			],
		},
	}}
>
	<div class="sl-markdown-content">
		<h2>Install</h2>
		<Code code={installExample} lang="sh" />

		<Aside type="caution" title="Android, and a development build">
			The hooks talk to Kotlin native modules that have to be compiled into your app, so this
			cannot run in Expo Go. Build it onto the device with <code>npx expo run:android</code> — one
			command, a few minutes the first time. On other platforms every native-backed hook reports
			<code>unavailable</code>.
		</Aside>

		<h2>Use it</h2>
		<Code code={usageExample} lang="tsx" />

		<h2>What you can read</h2>
		<table class="hook-table">
			<thead>
				<tr><th>Area</th><th>Hooks</th></tr>
			</thead>
			<tbody>
				{hookAreas.map((area) => (
					<tr>
						<td><strong>{area.label}</strong></td>
						<td>
							<span class="hook-list">
								{area.hooks.map((hook) => (
									<a
										class="hook-link"
										href={withBase(`/api/${SECTION_OF[hook.category]}/${hook.name.toLowerCase()}/`)}
										data-tip={hook.summary}
									>
										<code>{hook.name}</code>
									</a>
								))}
							</span>
						</td>
					</tr>
				))}
			</tbody>
		</table>

		<p>
			All {hookCount} hooks are documented with their arguments, every field they return with the
			type it really has, and a contract for each function they expose.
		</p>

		<h2>Where to go</h2>
		<CardGrid>
			<LinkCard
				title="Quickstart"
				href={withBase("/getting-started/quickstart/")}
				description="Install, build onto a device, and read your first value."
			/>
			<LinkCard
				title="API reference"
				href={withBase("/api/")}
				description="Every hook: inputs, outputs, and what failure looks like."
			/>
			<LinkCard
				title="Guides"
				href={withBase("/guides/")}
				description="On-device Gemini Nano, function calling, and voice."
			/>
			<LinkCard
				title="Architecture"
				href={withBase("/getting-started/architecture/")}
				description="How the hooks reach the hardware, layer by layer."
			/>
		</CardGrid>

		<p>
			Built from <a href="https://github.com/PixelKit-Labs/pixelkit-template">the template</a>? It
			is a working four-tab app exercising every hook on a real device. Something reading
			<code>—</code> and you are not sure why? <code>npx @pixelkit-labs/cli doctor</code> says which of
			adb, the device, the development build or AICore is missing.
		</p>
	</div>
</StarlightPage>

<style>
	/*
	 * The hook table is the landing page's own equivalent of Expo's landing-card grid, so it gets
	 * that treatment specifically (24px radius, 0.8px border, raised surface) rather than the
	 * smaller 12px radius `src/styles/pixelkit.css` gives ordinary API-reference tables — see
	 * GOAL item 5. Astro scopes this block to elements rendered in this file, so it cannot leak
	 * onto tables rendered from `docs/` content.
	 */
	.hook-table {
		border-radius: 1.5rem !important; /* 24px */
		background: var(--pk-surface-raised) !important;
		/* Starlight blockifies markdown tables and gives them `overflow: auto` so a wide one can
		   scroll. This table never needs to — it wraps — and the clipping that comes with it would
		   cut the hook tooltips off at the cell edge. */
		display: table !important;
		overflow: visible !important;
		width: 100% !important;
	}

	/* Gap rather than whitespace between the links: adjacent JSX elements render with none, so the
	   names ran together as one unreadable string. */
	.hook-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem 0.5rem; /* 6px 8px */
	}

	.hook-link {
		/* Positioning context only. The tooltip itself is styled once, site-wide, by the
		   `a[data-tip]` rules in src/styles/pixelkit.css - these links carry data-tip like any
		   other, so duplicating the block here would be a second thing to keep in step. */
		position: relative;
		text-decoration: none;
	}
	.hook-table th {
		background: transparent !important;
	}
</style>

